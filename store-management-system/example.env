# =============================================================================
# Ricky Mobile Store - CMS / Admin Dashboard (store-management-system)
# =============================================================================
# Copy this file to .env before starting the Next.js CMS:
#   cp example.env .env   (or copy example.env .env)
#
# QUICK START:
#   - Run: npm run dev (CMS will start on http://localhost:3000)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND API URL
# -----------------------------------------------------------------------------
# Public API Base URL pointing to the store_backend server (Default: http://localhost:8001)
NEXT_PUBLIC_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 2. APPLICATION BRANDING
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_TITLE="Ricky Mobile Store Admin"

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION (Optional - for admin authentication)
# -----------------------------------------------------------------------------
# MUST MATCH the GOOGLE_CLIENT_ID configured in store_backend/.env
# Add http://localhost:3000 to Authorized JavaScript origins in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 4. PAYMENT AND RECOVERY URLS (Canned Support Actions)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UPI_SPLIT_PAY_URL=https://upi.rickystore.in/pay/rms-split-pay
NEXT_PUBLIC_CHECKOUT_RETRY_URL=https://rickymobilestore.in/checkout?retry=true
