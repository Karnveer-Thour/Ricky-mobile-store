# =============================================================================
# Ricky Mobile Store - Main Website (store-web) Environment Configuration
# =============================================================================
# Copy this file to .env before starting the website:
#   cp example.env .env   (or copy example.env .env)
#
# QUICK START:
#   - Run: npm run dev (website will start on http://localhost:5173)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND API URL
# -----------------------------------------------------------------------------
# Base URL pointing to the store_backend server (Default: http://localhost:8001)
VITE_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 2. APPLICATION BRANDING
# -----------------------------------------------------------------------------
VITE_APP_TITLE="Ricky Mobile Store"

# Default automated greeting for support chat
VITE_CHAT_SUPPORT_REPLY="Thanks for your message! Our team at Khanna store will get back to you shortly. Typical response time is under 5 minutes."

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH SIGN-IN
# -----------------------------------------------------------------------------
# Google OAuth Client ID for customer sign-in via @react-oauth/google.
# MUST MATCH the GOOGLE_CLIENT_ID configured in store_backend/.env
#
# Steps:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Add http://localhost:5173 to Authorized JavaScript origins & redirect URIs
# 3. Paste the Client ID below:
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
