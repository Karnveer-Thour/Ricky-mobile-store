# Application Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ricky_mobile_store
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Security Credentials
JWT_SECRET=super_secret_jwt_signing_key_change_me
PASSWORD_PEPPER=random_pepper_string_for_bcrypt

# Firebase Credentials (Service Account)
TYPE=service_account
PROJECT_ID=mock-project-id
PRIVATE_KEY_ID=mock-private-key-id
# Note: For multiline private key, enclose in double quotes or replace newline characters with \n
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_PRIVATE_KEY_CREDENTIAL_DATA\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=mock@project.iam.gserviceaccount.com
CLIENT_ID=123456789
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=https://www.googleapis.com/renderer/certs
