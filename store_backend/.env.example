# =============================================================================
# Ricky Mobile Store - Backend Environment Configuration
# =============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env   (or copy example.env .env)
#
# QUICK START (Zero-Config Local Development):
#   - Keep DB_TYPE=sqlite (uses local ricky_mobile_store.sqlite, no DB install needed!)
#   - Run: npm run start:dev (server starts on http://localhost:8001)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION SERVER
# -----------------------------------------------------------------------------
# Port the NestJS backend listens on (Default: 8001)
# Note: store-web (Vite: 5173) and CMS (Next.js: 3000) connect to this port.
PORT=8001

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Supported values: 'sqlite' | 'postgres'
# - sqlite:   Uses local file ricky_mobile_store.sqlite. Perfect for quick setup!
# - postgres: Connects to PostgreSQL database using the credentials below.
DB_TYPE=sqlite

# PostgreSQL Settings (Active ONLY when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ricky_mobile_store
DB_SYNCHRONIZE=true
DB_LOGGING=false

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Google OAuth Client ID for authenticating users via Google Sign-In.
# MUST match VITE_GOOGLE_CLIENT_ID in store-web/.env
#
# Steps to obtain:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application Type: Web application)
# 3. Add Authorized JavaScript origins:
#      - http://localhost:5173 (store-web)
#      - http://localhost:3000 (store-management-system CMS)
# 4. Add Authorized redirect URIs:
#      - http://localhost:5173
#      - http://localhost:3000
# 5. Paste the Client ID below:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key used for signing JWT tokens
JWT_SECRET=ricky_mobile_store_jwt_secret_key_change_me_in_production

# Pepper string combined with passwords before bcrypt hashing
PASSWORD_PEPPER=ricky_mobile_store_password_pepper_secret_2026

# -----------------------------------------------------------------------------
# 5. AI MULTI-PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Provider options: 'gemini' | 'claude' | 'openai' | 'openllm' | 'offline'
# - offline: Uses built-in local device heuristics (no API key needed!)
# - gemini:  Uses Google Gemini (recommended, fastest response)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Keys (Provide the key corresponding to chosen AI_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENLLM_ENDPOINT=http://localhost:8000/v1

# -----------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA STORAGE (Optional - for image uploads)
# -----------------------------------------------------------------------------
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 7. FIREBASE ADMIN SERVICE ACCOUNT (Optional - for push notifications / auth)
# -----------------------------------------------------------------------------
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
TYPE=service_account
PROJECT_ID=mock-project-id
PRIVATE_KEY_ID=mock-private-key-id
# For multiline private key, enclose in double quotes and use \n for newlines
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_PRIVATE_KEY_CREDENTIAL_DATA\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=mock@project.iam.gserviceaccount.com
CLIENT_ID=123456789012345678901
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=https://www.googleapis.com/renderer/certs

# -----------------------------------------------------------------------------
# 8. EMI PARTNER SECRETS (Optional - for simulated Bajaj / Home Credit checkout)
# -----------------------------------------------------------------------------
BAJAJ_API_SECRET=default-bajaj-secret
HOMECREDIT_API_SECRET=default-hc-secret
